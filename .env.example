# The application joins the existing cs-ai-lab Docker network. It never starts
# PostgreSQL, Ollama, or n8n.
OPTIONS_KB_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/CHANGE_ME
OPTIONS_KB_OLLAMA_BASE_URL=http://ollama:11434
OPTIONS_KB_EMBEDDING_MODEL=bge-m3
OPTIONS_KB_EMBEDDING_DIMENSIONS=1024
OPTIONS_KB_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
OPTIONS_KB_STREAMLIT_BIND_ADDRESS=127.0.0.1
OPTIONS_KB_STREAMLIT_PORT=8502
OPTIONS_KB_API_PORT=8088
OPTIONS_KB_SEARCH_LIMIT=8
